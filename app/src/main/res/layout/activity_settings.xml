<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_midnight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customize"
            android:textSize="30sp"
            android:textColor="#6E6E80"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginTop="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:background="@drawable/hazard_stripes"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/nameButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="App name: Rude Awakening"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/backgroundButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Background: Pastel"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/shakesButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Shakes to stop: 20"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/snoozeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Snooze length: 5 min"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Done"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/metalCreditsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Metal credits"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
