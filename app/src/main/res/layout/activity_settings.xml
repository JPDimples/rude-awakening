<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_midnight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customize"
            android:textSize="30sp"
            android:textColor="#6E6E80"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginTop="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="@drawable/hazard_stripes"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm sound — tap one to hear it and save it"
            android:textSize="16sp"
            android:textColor="#8A8A9A"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/selectedSoundText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#E8E8F0"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/soundListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/nameButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="App name: Rude Awakening"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/backgroundButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Background: Pastel"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/shakesButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Shakes to stop: 20"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/snoozeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Snooze length: 5 min"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Done"
            android:textSize="16sp"
            android:textColor="#E8E8F0"
            android:background="@drawable/button_bg"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Metal clips: “Heavy Metal Riffs – Monolith” by Tri-Tachyon (CC BY), “Cyberpunk Metal” by Bertsz (CC0), “Hard Rock Loop” by BaDoink (CC0), “Heavy Metal” by Rínon Nínqueon (CC BY-SA), “Metal Hunters” by Gangrel (CC BY), “Metal Child” by Avenger Kills (CC BY), “So Metal It Hurts” by Daniel Bautista (CC BY), “True Metal Awaits” by Daniel Bautista (CC BY), “Death Metal Tango” by SadClown (CC BY-SA), “Long Live Heavy Metal” by black city (CC BY-SA). Trimmed to 30-second clips."
            android:textSize="12sp"
            android:textColor="#9A9AB0"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
