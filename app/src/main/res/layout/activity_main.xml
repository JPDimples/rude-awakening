<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_gradient">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rude Awakening"
        android:textSize="30sp"
        android:textColor="#6E6E80"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All alarms are off"
        android:textSize="20sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="20dp"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="56sp"
            android:textColor="#9A9AB0"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S   M   T   W   T   F   S"
            android:textSize="16sp"
            android:textColor="#B0B0C0"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/nextAlarmText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No alarm set"
            android:textSize="16sp"
            android:textColor="#8A8A9A"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <Button
        android:id="@+id/setAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Set alarm"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/setTimeButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Change alarm time"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/testVoiceButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Test male voice"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/testAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="TEST ALARM NOW"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/cancelAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cancel alarm"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/voiceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/permissionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/statusLogText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#9A9AB0"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20 shakes to shut it up. Snooze = +5 shakes."
        android:textSize="14sp"
        android:textColor="#9A9AB0"
        android:layout_marginTop="8dp" />

</LinearLayout>
