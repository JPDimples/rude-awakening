<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_gradient">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rude Awakening"
        android:textSize="30sp"
        android:textColor="#6E6E80"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/clockText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textSize="18sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All alarms are off"
        android:textSize="20sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/alarmListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <Button
        android:id="@+id/addAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+ Add alarm"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Customize"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/testMetalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Test metal sound"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/testAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="TEST ALARM NOW"
        android:textSize="16sp"
        android:textColor="#55556A"
        android:background="@drawable/button_bg"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/soundText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/permissionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#8A8A9A"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/statusLogText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#9A9AB0"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap an alarm to change its time and days."
        android:textSize="14sp"
        android:textColor="#9A9AB0"
        android:layout_marginTop="8dp" />

</LinearLayout>
